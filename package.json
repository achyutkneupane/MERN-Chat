{
  "name": "live_chat",
  "version": "1.0.0",
  "description": "MERN stack live-chat application.",
  "main": "index.js",
  "scripts": {
    "front": "cd client && npm run build",
    "back": "nodemon server.js",
    "build": "concurrently --kill-others-on-fail \"npm run front\" \"npm run back\"",
    "dev": "concurrently --kill-others-on-fail \"cd client && npm run dev\" \"npm run back\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/achyutkneupane/MERN-Chat.git"
  },
